{
  "name": "gtm-redteam",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "description": "Evidence-backed Adversarial GTM Audit Workbench",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/gtm-server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/gtm-server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e-ui.mjs",
    "visual": "node scripts/visual-check.mjs",
    "mock:model": "node scripts/mock-openai.mjs",
    "check:live": "tsx scripts/live-check.ts",
    "check:model": "tsx scripts/check-model.ts",
    "start:gtm": "tsx server/gtm-server.ts",
    "check:gtm-config": "tsx scripts/gtm-check-config.ts",
    "test:e2e:gtm": "tsx scripts/gtm-p2-e2e.ts",
    "smoke:gtm-real": "tsx scripts/gtm-real-smoke.ts",
    "check:release": "tsx scripts/release-safety.ts",
    "smoke": "tsx scripts/gtm-real-smoke.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
