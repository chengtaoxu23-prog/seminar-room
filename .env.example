# GTM-RedTeam v0.4-alpha: copy to .env.gtm.local; never commit filled values.
# Real workspace requires a real provider. No automatic mock fallback.
GTM_PROVIDER=openai-compatible
# Set openai-compatible explicitly for real requests.
GTM_BASE_URL=https://api.deepseek.com
GTM_MODEL=deepseek-flash
GTM_API_KEY=
# Historical audit/smoke cap (max 10). Research runs have a separate fixed 16-call cap.
GTM_MAX_CALLS=8
GTM_TIMEOUT_MS=60000

# Legacy SeminarRoom settings below are not read by the GTM entry point.
# Required: server-side only. Never commit this value or put it in browser storage.
OPENAI_API_KEY=

# Any OpenAI-compatible /chat/completions endpoint. These defaults point to OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional examples:
# DeepSeek:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-flash
#
# A local server that does not check keys can use a placeholder value:
# OPENAI_API_KEY=local-placeholder
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# Local server and hard caps.
SEMINAR_PORT=4317
SEMINAR_MAX_ROUNDS=6
SEMINAR_MAX_CALLS=30
SEMINAR_MAX_OUTPUT_TOKENS=700
SEMINAR_REQUEST_TIMEOUT_MS=60000
SEMINAR_TEMPERATURE=0.55

# Optional: override storage location.
# SEMINAR_DATA_DIR=./data/sessions
